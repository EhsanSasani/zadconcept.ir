STORY_VIDEO_PROCESS_TIMEOUT_SECONDS=600
STORY_VIDEO_KEEP_ORIGINALS=False
STORY_VIDEO_CRF=24
STORY_VIDEO_FFMPEG_PRESET=medium
STORY_VIDEO_FFMPEG_THREADS=1
STORY_FFMPEG_BINARY=ffmpeg
STORY_FFPROBE_BINARY=ffprobe

